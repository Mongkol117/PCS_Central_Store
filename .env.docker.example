# Copy this to .env for Docker development, then replace Supabase values.
# Docker Compose overrides DATABASE_URL, DIRECT_URL, SMTP, SERVER_URL, and DISABLE_HTTPS.

SUPABASE_URL="https://<your-project-ref>.supabase.co"
SUPABASE_ANON_PUBLIC="<your-supabase-anon-key>"
SUPABASE_SERVICE_ROLE="<your-supabase-service-role-key>"

SESSION_SECRET="replace-with-a-long-random-secret"
INVITE_TOKEN_SECRET="replace-with-another-long-random-secret"

APP_NAME="Central Store Asset Management"
ENABLE_PREMIUM_FEATURES="false"
DISABLE_SIGNUP="false"
DISABLE_SSO="true"
SEND_ONBOARDING_EMAIL="false"

MAPTILER_TOKEN=""
GEOCODING_USER_AGENT="Central Store Asset Management (http://localhost:3000)"
ADMIN_EMAIL="admin@central-store.local"
SUPPORT_EMAIL="support@central-store.local"
FULL_CALENDAR_LICENSE_KEY=""
